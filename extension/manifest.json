{
  "manifest_version": 3,
  "minimum_chrome_version": "111",
  "name": "Crypto-C Web3 Security",
  "version": "1.2.0",
  "description": "Local URL risk checks, wallet request reviews, and observed approval management.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "action": {
    "default_title": "Crypto-C Security"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "exclude_matches": [
        "http://127.0.0.1:8000/app/sandbox.html*",
        "http://localhost:8000/app/sandbox.html*"
      ]
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "exclude_matches": [
        "http://127.0.0.1:8000/app/sandbox.html*",
        "http://localhost:8000/app/sandbox.html*"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html"],
      "matches": ["http://*/*", "https://*/*"],
      "use_dynamic_url": true
    }
  ]
}
